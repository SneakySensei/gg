{
  "name": "gg",
  "version": "1.0.0",
  "private": true,
  "description": "GG – Greater experience for Gmail™: faster keyboard shortcuts and a cleaner Gmail.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "store:assets": "bun store/render-store-assets.ts",
    "release:check": "bun run compile && wxt zip && wxt zip -b firefox",
    "submit:dry": "wxt submit --dry-run --chrome-api-version v2 --chrome-zip .output/*-chrome.zip",
    "submit:chrome": "wxt submit --chrome-api-version v2 --chrome-zip .output/*-chrome.zip"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
