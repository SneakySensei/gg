# Copy to .env.submit (gitignored) and fill in once the extension exists in the
# Chrome Web Store. Used by `bun run submit:chrome:dry` / `bun run submit:chrome`.
# See docs/PUBLISHING.md, step 9.

# From the Developer Dashboard (the item's ID, and your publisher ID)
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=

# Service account with access to your Chrome Web Store publisher (API v2)
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
# Paste the private_key value from the service account JSON, keeping the \n escapes
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# Firefox Add-ons (AMO): Developer Hub > Tools > Manage API Keys
FIREFOX_EXTENSION_ID=gg@snehil.dev
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
